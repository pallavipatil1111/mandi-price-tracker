# Copy to .env (never commit .env). Used by docker compose.
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
ADMIN_EMAIL=admin@mandi.local
ADMIN_PASSWORD=change-this-admin-password
DB_PASSWORD=mandi
DB_ROOT_PASSWORD=root
DEMO_DATA=true
# sample = built-in data, datagov = live Agmarknet prices (free key from https://data.gov.in)
PRICE_SOURCE=sample
DATA_GOV_API_KEY=
DATA_GOV_STATE=Maharashtra
